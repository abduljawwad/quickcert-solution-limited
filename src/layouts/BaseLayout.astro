---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  jsonLd?: unknown;
  noindex?: boolean;
}

const { title, description, canonicalPath, jsonLd, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      jsonLd={jsonLd}
      noindex={noindex}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <div id="nav-progress" class="nav-progress" data-state="idle" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { bindClickFeedback } from "../scripts/click-feedback";

      bindClickFeedback();
    </script>
  </body>
</html>
