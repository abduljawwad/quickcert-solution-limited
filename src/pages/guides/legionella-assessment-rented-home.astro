---
import { guideByHref } from "../../components/guides/catalogue";
import { business } from "../../config/business";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { primaryActionClass, secondaryActionClass } from "../../lib/actions";
import { textLinkClass } from "../../lib/fields";

const guide = guideByHref("/guides/legionella-assessment-rented-home");
const path = guide.href;
const title = guide.title;
const description = guide.description;

function serviceBySlug(slug: string) {
  const service = business.services.find((item) => item.slug === slug);
  if (!service) {
    throw new Error(`Missing service: ${slug}`);
  }
  return service;
}

const legionella = serviceBySlug("legionella-risk-assessment");
const plumbing = serviceBySlug("plumbing");

const origin = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(path, origin).href;
const siteUrl = new URL("/", origin).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  url: pageUrl,
  author: {
    "@type": "Organization",
    name: business.legalName,
    url: siteUrl,
  },
};
---

<BaseLayout title={title} description={description} canonicalPath={path} jsonLd={jsonLd}>
  <section aria-labelledby="guide-heading">
    <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:py-20 lg:py-24">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-x-2 text-sm">
          <li>
            <a href="/" class={textLinkClass}>Home</a>
          </li>
          <li class="flex items-center gap-x-2">
            <span aria-hidden="true" class="text-on-surface-variant">/</span>
            <a href="/guides" class={textLinkClass}>Guides</a>
          </li>
          <li class="flex min-w-0 items-center gap-x-2" aria-current="page">
            <span aria-hidden="true" class="text-on-surface-variant">/</span>
            <span class="inline-flex min-h-11 items-center text-on-surface">{guide.label}</span>
          </li>
        </ol>
      </nav>

      <h1
        id="guide-heading"
        class="mt-8 max-w-3xl text-4xl leading-tight text-balance text-primary sm:text-5xl"
      >
        {title}
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-7 text-pretty text-on-surface">
        A Legionella assessment of a rented home is a visit to look at the water system and write
        down the risk. This page describes the visit {business.shortName} carries out. It is general
        guidance, not legal advice.
      </p>

      <section aria-labelledby="look-heading" class="mt-12 max-w-3xl">
        <h2 id="look-heading" class="text-3xl leading-tight text-balance text-primary">
          What the assessor looks at
        </h2>
        <p class="mt-4 leading-7 text-pretty text-on-surface">
          The assessor visits the house or flat and looks at the water system as it is on the day.
          That includes water that is stored, the hot water, and the taps and showers people use.
          The written assessment records the Legionella risk from that system.
        </p>
        <p class="mt-4 leading-7 text-pretty text-on-surface">
          The visit is the written assessment. Plumbing work, if the property needs it, is quoted
          separately.
        </p>
        <p class="mt-4">
          <a
            href={`/services/${plumbing.slug}`}
            class:list={[textLinkClass, "max-w-full whitespace-normal"]}
          >
            {plumbing.name} in {business.baseTown}
          </a>
        </p>
      </section>

      <section
        aria-labelledby="who-heading"
        class="mt-12 max-w-3xl border-t border-outline/40 pt-8"
      >
        <h2 id="who-heading" class="text-3xl leading-tight text-balance text-primary">
          Who asks for it
        </h2>
        <p class="mt-4 leading-7 text-pretty text-on-surface">
          Landlords and letting agents book this assessment for a home they let in {business.baseTown}.
          The same visit is arranged for rented homes in Warwick, Royal Leamington Spa, Rugby,
          Nuneaton, Birmingham, Leicester, and the other places we cover.
        </p>
        <p class="mt-4">
          <a href="/guides/landlord-compliance-checklist" class={textLinkClass}>
            Which services a landlord may need
          </a>
        </p>
      </section>

      <section
        aria-labelledby="receive-heading"
        class="mt-12 max-w-3xl border-t border-outline/40 pt-8"
      >
        <h2 id="receive-heading" class="text-3xl leading-tight text-balance text-primary">
          What you receive
        </h2>
        <p class="mt-4 leading-7 text-pretty text-on-surface">
          You receive the written Legionella risk assessment by email after the visit. The price is
          on the service page. You book there. Payment is on a secure Stripe page. The assessment records the risk found on the
          day.
        </p>
        <p class="mt-4 leading-7 text-pretty text-on-surface">
          {business.shortName} is based in {business.baseTown}. Visits also cover {business.serviceAreaPhrase}.
        </p>
        <p class="mt-4">
          <a href="/areas" class={textLinkClass}>Areas we cover</a>
          <span class="text-on-surface-variant"> · </span>
          <a href="/guides" class={textLinkClass}>All guides</a>
        </p>
      </section>

      <div class="mt-8 flex max-w-3xl flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={`/services/${legionella.slug}`}
          class:list={[primaryActionClass, "w-full sm:w-auto"]}
        >
          View the Legionella assessment
        </a>
        <a href="/contact" class:list={[secondaryActionClass, "w-full sm:w-auto"]}>
          Contact {business.shortName}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
