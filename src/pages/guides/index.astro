---
import { guidePages } from "../../components/guides/catalogue";
import { business } from "../../config/business";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { textLinkClass } from "../../lib/fields";

const path = "/guides";
const title = `Guides for landlords and sellers in ${business.baseTown}`;
const description = `Short answers on domestic and commercial EPCs, Legionella assessments, fire risk assessments, and PAT testing for landlords in ${business.baseTown}.`;

const origin = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(path, origin).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: pageUrl,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: guidePages.map((guide, index) => ({
      "@type": "ListItem" as const,
      position: index + 1,
      name: guide.title,
      url: new URL(guide.href, origin).href,
    })),
  },
};
---

<BaseLayout title={title} description={description} canonicalPath={path} jsonLd={jsonLd}>
  <section aria-labelledby="guides-heading">
    <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:py-20 lg:py-24">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-x-2 text-sm">
          <li>
            <a href="/" class={textLinkClass}>Home</a>
          </li>
          <li class="flex items-center gap-x-2" aria-current="page">
            <span aria-hidden="true" class="text-on-surface-variant">/</span>
            <span class="inline-flex min-h-11 items-center text-on-surface">Guides</span>
          </li>
        </ol>
      </nav>

      <h1
        id="guides-heading"
        class="mt-8 max-w-3xl text-4xl leading-tight text-balance text-primary sm:text-5xl"
      >
        {title}
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-7 text-pretty text-on-surface">
        Short guides on the visits {business.shortName} carries out from {business.baseTown}. Each
        one answers a single question. Prices and booking stay on the service pages.
      </p>
      <p class="mt-4 max-w-3xl leading-7 text-pretty text-on-surface">
        Visits also cover {business.serviceAreaPhrase}.{" "}
        <a href="/areas" class={textLinkClass}>Areas we cover</a>.
      </p>

      <ul class="mt-12 max-w-3xl divide-y divide-outline/40">
        {
          guidePages.map((guide) => (
            <li class="py-8">
              <h2 class="text-2xl leading-tight text-balance text-primary">
                <a href={guide.href} class:list={[textLinkClass, "max-w-full whitespace-normal"]}>
                  {guide.label}
                </a>
              </h2>
              <p class="mt-3 leading-7 text-pretty text-on-surface">{guide.summary}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
