---
import { faqs, visitOutcome } from "../../components/home/content";
import { business, type Service } from "../../config/business";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { primaryActionClass, secondaryActionClass } from "../../lib/actions";
import { formatPrice } from "../../lib/price";

const bookable = business.services.filter(
  (service): service is Extract<Service, { kind: "book" }> => service.kind === "book",
);

const quotes = business.services.filter(
  (service): service is Extract<Service, { kind: "quote" }> => service.kind === "quote",
);

function requireFaq(question: (typeof faqs)[number]["question"]) {
  const item = faqs.find((entry) => entry.question === question);
  if (!item) {
    throw new Error(`Services page FAQ is missing "${question}".`);
  }
  return item;
}

const pageFaqs = [
  requireFaq("How does payment work?"),
  requireFaq("What is the difference between a booked visit and a quote?"),
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: pageFaqs.map((item) => ({
    "@type": "Question" as const,
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer" as const,
      text: item.answer,
    },
  })),
};

const title = `EPC and other services in ${business.baseTown}`;
const description = `Priced visits in ${business.baseTown} and across ${business.serviceAreaPhrase}. Electrical and plumbing work is quoted before payment.`;

const cardLinkClass = "mt-4 w-full min-w-0 whitespace-normal py-2 text-balance";
---

<BaseLayout title={title} description={description} canonicalPath="/services" jsonLd={jsonLd}>
  <section aria-labelledby="services-heading">
    <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:py-20 lg:py-24">
      <h1
        id="services-heading"
        class="max-w-3xl text-4xl leading-tight text-balance text-primary sm:text-5xl"
      >
        {title}
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-7 text-pretty text-on-surface">
        Priced visits you can book now in {business.baseTown} and across {business.serviceAreaPhrase}.
        Electrical work and plumbing are quoted before any payment.
      </p>

      <section aria-labelledby="priced-visits-heading" class="mt-12">
        <h2 id="priced-visits-heading" class="text-3xl leading-tight text-balance text-primary">
          Priced visits
        </h2>
        <p class="mt-4 max-w-3xl leading-7 text-pretty text-on-surface">{visitOutcome}</p>
        <ul class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
          {
            bookable.map((service) => (
              <li class="flex h-full flex-col border border-outline/40 bg-surface-container-lowest p-5">
                <h3 class="text-xl leading-tight text-primary">{service.name}</h3>
                <p class="mt-3 flex-1 leading-7 text-on-surface">{service.summary}</p>
                <p class="mt-6 text-lg font-semibold text-on-surface tabular-nums">
                  {formatPrice(service.pricePence)}
                </p>
                <a
                  href={`/book/${service.slug}`}
                  class:list={[primaryActionClass, cardLinkClass]}
                >
                  Book {service.name}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="written-quotes-heading" class="mt-12">
        <h2 id="written-quotes-heading" class="text-3xl leading-tight text-balance text-primary">
          Written quotes
        </h2>
        <ul class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
          {
            quotes.map((service) => (
              <li class="flex h-full flex-col border border-outline/40 bg-surface-container-lowest p-5">
                <h3 class="text-xl leading-tight text-primary">{service.name}</h3>
                <p class="mt-3 flex-1 leading-7 text-on-surface">{service.summary}</p>
                <p class="mt-6 text-lg font-semibold text-on-surface">Written quote</p>
                <a
                  href={`/services/${service.slug}`}
                  class:list={[secondaryActionClass, cardLinkClass]}
                >
                  Request a quote for {service.name}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </section>

  <section aria-labelledby="questions-heading">
    <div class="mx-auto w-full max-w-6xl px-4">
      <div class="border-t border-outline/40 py-14 lg:py-20">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-16">
        <h2 id="questions-heading" class="text-3xl leading-tight text-balance text-primary">
          Questions
        </h2>
        <ul class="divide-y divide-outline/40">
          {
            pageFaqs.map((item) => (
              <li>
                <details>
                  <summary>
                    <h3>{item.question}</h3>
                    <span class="question-mark" aria-hidden="true"></span>
                  </summary>
                  <p>{item.answer}</p>
                </details>
              </li>
            ))
          }
        </ul>
      </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 2.75rem;
    padding-block: 0.75rem;
    list-style: none;
    text-align: left;
    cursor: pointer;
    transition: background-color 200ms;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    background-color: var(--color-surface-container-low);
  }

  summary h3 {
    flex: 1;
    min-width: 0;
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--color-on-surface);
  }

  summary + p {
    padding-bottom: 1.25rem;
    line-height: 1.75;
    color: var(--color-on-surface);
  }

  .question-mark {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-size: 1.5rem;
    line-height: 1;
  }

  .question-mark::before {
    content: "+";
  }

  details[open] .question-mark::before {
    content: "−";
  }
</style>
