---
import { paymentSentences } from "./content";
---

<section aria-labelledby="pay-heading">
  <div class="mx-auto w-full max-w-6xl px-4">
    <div class="border-t border-outline/40 py-14 lg:py-20">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-16">
        <h2 id="pay-heading" class="text-3xl leading-tight text-balance text-primary">
          Pay with confidence
        </h2>
        <ul class="divide-y divide-outline/40">
          {
            paymentSentences.map((sentence) => (
              <li class="py-4 leading-7 text-on-surface">{sentence}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
