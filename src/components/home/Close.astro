---
import { primaryActionClass, secondaryActionClass } from "../../lib/actions";
---

<section aria-labelledby="close-heading">
  <div class="mx-auto w-full max-w-6xl px-4">
    <div class="border-t border-outline/40 py-14 lg:py-20">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <h2 id="close-heading" class="max-w-xl text-3xl leading-tight text-balance text-primary">
        Book or ask for a quote
      </h2>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href="/services" class:list={[primaryActionClass, "w-full sm:w-auto"]}>
          Book a priced visit
        </a>
        <a href="/contact" class:list={[secondaryActionClass, "w-full sm:w-auto"]}>
          Describe electrical or plumbing work
        </a>
      </div>
    </div>
    </div>
  </div>
</section>
