---
import { quoteClarification, visitOutcome } from "./content";

const steps = [
  {
    title: "Choose the service",
    text: "Select the certificate or report you need.",
  },
  {
    title: "Enter your details and pay",
    text: "The price shown is the price you pay.",
  },
  {
    title: "We visit and email the report",
    text: visitOutcome,
  },
] as const;
---

<section aria-labelledby="steps-heading">
  <div class="mx-auto w-full max-w-6xl px-4">
    <div class="border-t border-outline/40 py-14 lg:py-20">
    <h2 id="steps-heading" class="text-3xl leading-tight text-balance text-primary">How it works</h2>
    <p class="mt-4 text-lg leading-7 text-on-surface">For a priced visit.</p>
    <ol class="mt-8 grid list-none grid-cols-1 gap-8 lg:grid-cols-3">
      {
        steps.map((step, index) => (
          <li class="border-t border-outline/40 pt-5">
            <p class="font-heading text-4xl text-primary" aria-hidden="true">
              {index + 1}
            </p>
            <h3 class="mt-3 text-2xl leading-tight text-primary">{step.title}</h3>
            <p class="mt-3 leading-7 text-on-surface">{step.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 max-w-2xl leading-7 text-on-surface">{quoteClarification}</p>
    </div>
  </div>
</section>
