---
import { business } from "../config/business";
import { guideLinks, legalNav, serviceLinks } from "../config/nav";
import { googleReviewHref } from "../lib/review";

const areaLine = new Intl.ListFormat("en-GB", {
  style: "long",
  type: "conjunction",
}).format([...business.areas]);

const reviewUrl = googleReviewHref(business.googleReviewUrl);

const textLinkClass =
  "block min-h-11 w-full break-words py-2.5 text-sm leading-6 underline decoration-on-primary/50 underline-offset-4 hover:decoration-on-primary";
---

<footer class="bg-primary text-on-primary">
  <div class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-12 sm:grid-cols-2 lg:grid-cols-3">
    <address class="not-italic">
      <p class="font-heading text-2xl font-semibold">{business.legalName}</p>
      <p class="mt-3 text-sm leading-6">{business.registeredOffice}</p>
      <p class="mt-1 text-sm leading-6">Registered in {business.registeredIn}</p>
      <p class="mt-1 text-sm leading-6">Company number {business.companyNumber}</p>
      {
        business.vatNumber.trim() && (
          <p class="mt-1 text-sm leading-6">VAT number {business.vatNumber.trim()}</p>
        )
      }
      <p class="mt-3">
        <a href={business.phoneHref} class={textLinkClass}>
          <span class="sr-only">Call</span>
          {business.phoneDisplay}
        </a>
      </p>
      <p>
        <a href={`mailto:${business.email}`} class={textLinkClass}>{business.email}</a>
      </p>
      <p class="mt-3 text-sm leading-6">Opening hours: {business.hours}</p>
    </address>

    <nav aria-label="Services">
      <h2 class="text-xl font-semibold">Services</h2>
      <ul class="mt-2">
        {
          serviceLinks.map((link) => (
            <li>
              <a href={link.href} class={textLinkClass}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="sm:col-span-2 lg:col-span-1">
      <h2 class="text-xl font-semibold">Areas we cover</h2>
      <p class="mt-3 text-sm leading-6">{areaLine}</p>

      <nav aria-label="Guides" class="mt-8">
        <h2 class="text-xl font-semibold">Guides</h2>
        <ul class="mt-2">
          {
            guideLinks.map((link) => (
              <li>
                <a href={link.href} class={textLinkClass}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Policies" class="mt-8">
        <h2 class="text-xl font-semibold">Policies</h2>
        <ul class="mt-2">
          {
            legalNav.map((link) => (
              <li>
                <a href={link.href} class={textLinkClass}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        reviewUrl && (
          <p class="mt-2">
            <a href={reviewUrl} class={textLinkClass} rel="noopener noreferrer" target="_blank">
              Read our Google reviews
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </p>
        )
      }
    </div>
  </div>
</footer>
